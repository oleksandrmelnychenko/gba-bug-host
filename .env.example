PORT=4000
# APP_BUILD_NUMBER=2026.08.06.1
# DATA_DIR=./data
# UPLOAD_DIR=./public/uploads

# Репозиторій, який Codex виправлятиме в окремих git worktrees.
# CODEX_TARGET_REPO=/srv/gba-console
# CODEX_WORKTREES_DIR=/srv/gba-worktrees
# CODEX_BIN=codex
# CODEX_MODEL=
# CODEX_POLL_INTERVAL_MS=1500
# CODEX_JOB_TIMEOUT_MS=2700000
# CODEX_NETWORK_ACCESS=false
# Coding queue is intentionally singleton; CODEX_CONCURRENCY is fixed to 1.
# CODEX_REFERENCE_REPOS_CONSOLE=/srv/gba-client-legacy
# CODEX_REFERENCE_REPOS_ECOMMERCE=
# CODEX_WORKER_LEASE_NAME=codex-worker
# CODEX_WORKER_LEASE_TTL_MS=20000
# CODEX_WORKER_HEARTBEAT_MS=5000
# CODEX_CONTEXT_FILE=./server/codex-worker-context.md
# CODEX_CONTEXT_HISTORY_LIMIT=20
# CODEX_CONTEXT_MAX_LENGTH=30000
# CODEX_CONTEXT_EPOCH_KEY=codex-worker-context-v1
# CODEX_RUN_STALE_MS=30000

# Внутрішній Bearer token для sentinel/release worker. Згенеруйте щонайменше 32 випадкові байти.
# QA_DESK_INTERNAL_API_TOKEN=

# Для авторизації Codex CLI worker. Не комітьте реальний ключ.
# OPENAI_API_KEY=

# Локальна voice-транскрипція через shell + faster-whisper (без зовнішнього API).
# VOICE_TRANSCRIBE_PYTHON=./.voice-venv/bin/python
# VOICE_TRANSCRIBE_MODEL=base
# VOICE_TRANSCRIBE_DEVICE=cpu
# VOICE_TRANSCRIBE_COMPUTE_TYPE=int8
# VOICE_TRANSCRIBE_TIMEOUT_MS=180000
# WHISPER_CACHE_DIR=./data/whisper-cache

# Для docker compose обидва шляхи мають бути абсолютними на сервері.
# CODEX_TARGET_REPO_HOST_PATH=/srv/gba-console
# CODEX_SERVER_REPO_HOST_PATH=/srv/gba-server
# CODEX_ECOMMERCE_REPO_HOST_PATH=/srv/gba-ecommerce
# CODEX_ECOMMERCE_API_REPO_HOST_PATH=/srv/gba-ecommerce-api
# CODEX_WORKTREES_HOST_PATH=/srv/gba-worktrees
# RTK_HOST_PATH=/absolute/path/to/rtk
