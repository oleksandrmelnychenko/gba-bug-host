PORT=4000
# APP_BUILD_NUMBER=2026.08.06.1
# DATA_DIR=./data
# UPLOAD_DIR=./public/uploads

# Репозиторій, який Codex виправлятиме в окремих git worktrees.
# CODEX_TARGET_REPO=/srv/gba-console
# CODEX_WORKTREES_DIR=/srv/gba-worktrees
# CODEX_BIN=codex
# CODEX_MODEL=
# CODEX_POLL_INTERVAL_MS=1500
# CODEX_JOB_TIMEOUT_MS=2700000
# CODEX_NETWORK_ACCESS=false
# CODEX_CONCURRENCY=3

# Для серверного worker. Не комітьте реальний ключ.
# OPENAI_API_KEY=

# Для docker compose обидва шляхи мають бути абсолютними на сервері.
# CODEX_TARGET_REPO_HOST_PATH=/srv/gba-console
# CODEX_WORKTREES_HOST_PATH=/srv/gba-worktrees
